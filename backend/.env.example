# Development defaults are intentionally local-only. Set all values explicitly in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production database settings:
# DB_ENGINE=postgres
# DB_NAME=answer
# DB_USER=questlab
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432
