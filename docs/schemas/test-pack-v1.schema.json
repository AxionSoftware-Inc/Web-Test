{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questlab.local/schemas/test-pack-v1.schema.json",
  "title": "QuestLab Test Pack v1",
  "description": "Canonical authoring/import format for a test pack. Runtime API responses use normalized database fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pack", "tests"],
  "properties": {
    "version": { "const": "1.0" },
    "pack": { "$ref": "#/$defs/pack" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subject", "branch", "level", "language"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct"],
      "properties": {
        "correct": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body", "answer", "skills"],
      "properties": {
        "type": {
          "enum": ["single_choice", "multiple_choice", "short_answer"]
        },
        "body": { "$ref": "#/$defs/nonEmptyString" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        },
        "answer": { "$ref": "#/$defs/answer" },
        "explanation": { "type": "string" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["single_choice", "multiple_choice"] }
            },
            "required": ["type"]
          },
          "then": { "required": ["options"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "short_answer" } },
            "required": ["type"]
          },
          "then": { "not": { "required": ["options"] } }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "topic", "difficulty", "time_limit_minutes", "questions"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "topic": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "time_limit_minutes": { "type": "integer", "minimum": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    }
  }
}
